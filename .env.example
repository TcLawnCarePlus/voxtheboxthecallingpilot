# VoxTheBoxTheCallingPilot — example environment file (TEST MODE ONLY).
# Copy to ".env" for local runs. NEVER commit .env, and NEVER put a live
# Stripe key, a carrier key, a bank/routing/account number, or any
# telephony credential in this file or in the code.
PORT=
PUBLIC_BASE_URL=
SESSION_SECRET=
OWNER_EMAIL=
OWNER_PASSWORD=
# Stripe TEST keys only (sk_test_ / pk_test_ / whsec_). A live sk_live_
# key is REFUSED at startup and billing disables itself.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# AI provider (OpenAI-compatible). Leave empty for scripted fallback replies.
AI_PROVIDER_API_KEY=
AI_MODEL=
AI_API_BASE_URL=
# Platform carrier (bundled model) — DEFERRED. Leave empty until the
# operator creates the platform carrier account themselves.
PLATFORM_CARRIER_API_KEY=
PLATFORM_CARRIER_ACCOUNT_ID=
# Local database file (used only when DATABASE_URL is not set).
SQLITE_FILE=
